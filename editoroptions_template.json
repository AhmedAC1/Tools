{
  "spaces_per_indent": 4,
  "spaces_per_tab": 4,
  "recommended_languages": ["lua", "luau"],
  "end_of_line_char": "\n",
  "replacements": {
    "space": ["display_only", "#AAAAAA", "·"],
    "tab": ["display_only", "····"]
  },
  "highlighting": {
    "keywords": "color:red_fancy:bold",
    "numbers": "color:hex#0081E7",
    "strings": "color:hex#0081E7",
    "operators": "color:hex#A2A264",
    "comments": "color:hex#AAAAAA_fancy:italic"
  }
}